    "Pick Allow on the dialog the TV is showing. Keys, typing and live view need it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Autoriser dans la fenêtre affichée sur la télé. Les touches, l’écriture et la vue en direct en ont besoin."
          }
        }
      }
    },
    "Turn on debugging": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
