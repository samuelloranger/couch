    },
    "This TV doesn't let Couch use debugging, so keys, typing and live view won't work. Apps and settings still do.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette télé ne laisse pas Couch utiliser le débogage : les touches, l’écriture et la vue en direct ne marcheront pas. Les applis et les réglages, oui."
          }
        }
      }
    },
