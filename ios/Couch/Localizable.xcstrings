    "Couldn't reach the TV. Check that you are on the same network.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre la télé. Vérifie que tu es sur le même réseau."
