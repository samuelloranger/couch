    },
    "The TV didn't confirm. Try pairing again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La télé n’a pas confirmé. Réessaie de jumeler."
