    },
    "This TV isn't waiting for a phone. On the TV, open Customize, then Phone, then Pair a phone.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette télé n’attend pas de téléphone. Sur la télé, ouvre Personnaliser, puis Téléphone, puis Jumeler un téléphone."
          }
        }
      }
    },
    "The TV sent something unexpected. Update Couch on the TV and try again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La télé a envoyé une réponse inattendue. Mets Couch à jour sur la télé et réessaie."
