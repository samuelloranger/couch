<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to the TV's own control API on this device (Sony's IP control listens on
     127.0.0.1:80 without TLS). Everything else keeps Android's HTTPS-only default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
