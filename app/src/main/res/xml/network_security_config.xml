<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed because Couch talks to devices on the home network that only speak it:
     the TV's own control API (Sony's IP control on 127.0.0.1:80) and Home Assistant, usually
     http://<address>:8123. Their addresses are the user's, so no domain list can name them. Couch's
     internet requests (weather, wallpapers, updates) all use https URLs. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
